# Copy to .env and fill in your keys. Every setting except the four secrets is optional;
# the value shown is the default.

# --- Secrets (required) ---------------------------------------------------------
PLEX_TOKEN=
TAUTULLI_KEY=
LIDARR_API_KEY=
GEMINI_API_KEY=

# --- Plex ------------------------------------------------------------------------
# Library section id of your Music library (Plex Web: Library > Music, the number in the URL).
# MUSIC_SECTION_ID=2

# --- Service URLs used by the app itself -------------------------------------------
# In Docker these are set by docker-compose.yml to http://host.docker.internal:<port>;
# only set them here when running outside Docker or when a service lives elsewhere.
# PLEX_URL=http://127.0.0.1:32400
# TAUTULLI_URL=http://127.0.0.1:8181
# LIDARR_URL=http://127.0.0.1:8686
# DEEMIX_URL=http://127.0.0.1:6595
# OLLAMA_URL=http://127.0.0.1:11434

# --- Links shown in the browser ---------------------------------------------------
# Host used to build the service links in the UI (e.g. your Tailscale name).
PUBLIC_HOST=http://localhost
# Override individual links if a service isn't at PUBLIC_HOST:<default port>.
# PLEX_PUBLIC_URL=http://localhost:32400
# TAUTULLI_PUBLIC_URL=http://localhost:8181
# LIDARR_PUBLIC_URL=http://localhost:8686
# DEEMIX_PUBLIC_URL=http://localhost:6595

# --- Lidarr ----------------------------------------------------------------------
# Where "Add to Lidarr" puts new artists. Blank = read from Lidarr (first root folder /
# profile). If Lidarr can't be read and these are blank, adding is refused rather than guessed.
# LIDARR_ROOT_FOLDER=
# LIDARR_QUALITY_PROFILE_ID=
# LIDARR_METADATA_PROFILE_ID=

# --- AI DJ ------------------------------------------------------------------------
# Default provider ("gemini" or "ollama"); the UI toggle overrides it and is remembered.
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-flash-latest
# Monthly cap in USD. Months follow UTC (reset 00:00 UTC on the 1st).
GEMINI_MONTHLY_BUDGET_USD=1.50
# Prices used for spend tracking: check them against your Google AI billing page.
# GEMINI_PRICE_IN_PER_1M=0.50
# GEMINI_PRICE_OUT_PER_1M=3.00
# Per-call output cap (thinking included); also the worst case reserved against the budget.
# GEMINI_MAX_OUTPUT_TOKENS=4096
OLLAMA_MODEL=hermes3:8b
# Seconds to wait for Ollama before falling back to Gemini.
# OLLAMA_TIMEOUT=60

# --- Playlists & discovery ----------------------------------------------------------
# Skip tracks played within this many days when building playlists (0 = off).
# RECENTLY_PLAYED_DAYS=14
# Albums the weekly discovery crawl adds.
# DISCOVERY_PICKS_PER_WEEK=6

# --- Scheduler ----------------------------------------------------------------------
# Time zone for the schedules below, e.g. America/Chicago, Europe/London.
# TZ=UTC
# 5-field cron: minute hour day-of-month month day-of-week. Use "off" to disable a task.
# An invalid value disables that task and is reported in the log at startup.
# NIGHTLY_REINDEX_CRON=30 3 * * *
# WEEKLY_REFRESH_CRON=0 9 * * mon
# WEEKLY_DISCOVERY_CRON=30 9 * * mon
# Set to 0 to turn the in-app scheduler off entirely.
# RUN_SCHEDULER=1

# --- Runtime ------------------------------------------------------------------------
# DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO
# Docker: user id that owns ./data on the host (on Linux, the output of `id -u`).
# APP_UID=1000
# Lock files. Must be on a filesystem that enforces file locks; the default (container /tmp)
# does. Don't point this at ./data on Docker Desktop for Mac (locks aren't enforced there).
# LOCK_DIR=
