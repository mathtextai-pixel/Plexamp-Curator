# Copy to .env and fill in your keys
PLEX_TOKEN=
TAUTULLI_KEY=
LIDARR_API_KEY=
GEMINI_API_KEY=

# Optional overrides
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-flash-latest
GEMINI_MONTHLY_BUDGET_USD=1.50
OLLAMA_MODEL=hermes3:8b
PUBLIC_HOST=http://localhost

# Time zone for the scheduler, e.g. America/Chicago, Europe/London (default UTC)
# TZ=UTC

# Docker: user id that owns ./data on the host (default 1000; on Linux use the output of `id -u`)
# APP_UID=1000

# Gemini: per-call output token cap (also used for the worst-case budget estimate).
# The monthly budget resets at 00:00 UTC on the 1st.
# GEMINI_MAX_OUTPUT_TOKENS=4096

# Logging: DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO

# Scheduler (5-field cron: minute hour day-of-month month day-of-week; container local time,
# set TZ to change it). Use "off" to disable a task. An invalid value disables that task
# and is reported in the log at startup.
# NIGHTLY_REINDEX_CRON=30 3 * * *
# WEEKLY_REFRESH_CRON=0 9 * * mon
# WEEKLY_DISCOVERY_CRON=30 9 * * mon
